# Copie para .env (não versionado). Segredos só no ambiente de execução.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Em Vercel: opcional — usa https://$VERCEL_PROJECT_PRODUCTION_URL (ou VERCEL_URL no preview).
# Em produção local/Docker: obrigatório com https.

# Postgres (Supabase). Dev/teste: vazio usa PGlite em ./.pglite
# Preferir Session pooler na Vercel (porta 6543) para menos conexões.
# Formato: postgresql://postgres.REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Ou direto: postgresql://postgres:SENHA@db.REF.supabase.co:5432/postgres?sslmode=require
# Teste: npm run db:check
DATABASE_URL=

SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32+-caracteres

# Acesso privado: senha única do proprietário (hash scrypt).
# Gere com:  read -s -p "Senha: " P; echo; printf %s "$P" | npm run -s hash-password
OWNER_PASSWORD_HASH=

# Cron da Vercel (purge de sessões). Gere um segredo forte e configure no painel.
CRON_SECRET=

# Opcional: login com Google (preencha os TRÊS ou nenhum).
# URI de redirecionamento autorizado: ${BASE_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GOOGLE_SUB=
